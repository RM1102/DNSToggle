#!/bin/bash
# Privileged helper for DNSToggle — only known presets, no arbitrary commands.
# Must run as root via sudo -n. Exactly one argument.
# Version 2: root check, Wi-Fi/Ethernet-only enable, never abort mid-clear.
set -u

HELPER_VERSION="2"

if [ "$(id -u)" -ne 0 ]; then
  echo "must run as root" >&2
  exit 1
fi

if [ "$#" -ne 1 ]; then
  echo "usage: $0 {version|ping|cloudflare|google|quad9|opendns|adguard|controld|mullvad|auto|clear|flush|proxy-on|proxy62-on|proxy22-on|proxy-off}" >&2
  exit 1
fi

# Reject anything that is not a plain token (defense in depth vs sudoers typos).
case "$1" in
  *[!a-z0-9-]*)
    echo "invalid action" >&2
    exit 1
    ;;
esac

PROXY_PORT="3128"

flush_dns() {
  /usr/bin/dscacheutil -flushcache 2>/dev/null || true
  /usr/bin/killall -HUP mDNSResponder 2>/dev/null || true
}

active_services() {
  /usr/sbin/networksetup -listallnetworkservices 2>/dev/null | awk 'NR>1 && $0 !~ /^\*/'
}

# Enable only primary links — never iPhone USB / Thunderbolt Bridge (tethering brick).
enable_services() {
  while IFS= read -r svc; do
    [ -z "$svc" ] && continue
    local lower
    lower="$(printf '%s' "$svc" | tr '[:upper:]' '[:lower:]')"
    case "$lower" in
      *wi-fi*|*wifi*|*airport*|*ethernet*)
        printf '%s\n' "$svc"
        ;;
    esac
  done < <(active_services)
}

apply_dns() {
  while IFS= read -r svc; do
    [ -z "$svc" ] && continue
    /usr/sbin/networksetup -setdnsservers "$svc" "$@" 2>/dev/null || true
  done < <(active_services)
}

# Never abort mid-loop — leftover proxy on one service is worse than a noisy error.
clear_proxies() {
  while IFS= read -r svc; do
    [ -z "$svc" ] && continue
    /usr/sbin/networksetup -setwebproxystate "$svc" off 2>/dev/null || true
    /usr/sbin/networksetup -setsecurewebproxystate "$svc" off 2>/dev/null || true
    /usr/sbin/networksetup -setsocksfirewallproxystate "$svc" off 2>/dev/null || true
    /usr/sbin/networksetup -setautoproxystate "$svc" off 2>/dev/null || true
    /usr/sbin/networksetup -setproxybypassdomains "$svc" Empty 2>/dev/null || true
    /usr/sbin/networksetup -setwebproxy "$svc" "" "" off 2>/dev/null || true
    /usr/sbin/networksetup -setsecurewebproxy "$svc" "" "" off 2>/dev/null || true
    /usr/sbin/networksetup -setwebproxystate "$svc" off 2>/dev/null || true
    /usr/sbin/networksetup -setsecurewebproxystate "$svc" off 2>/dev/null || true
  done < <(active_services)
}

enable_iitd_proxy() {
  local host="$1"
  local any=0
  while IFS= read -r svc; do
    [ -z "$svc" ] && continue
    /usr/sbin/networksetup -setwebproxy "$svc" "$host" "$PROXY_PORT" off 2>/dev/null || continue
    /usr/sbin/networksetup -setsecurewebproxy "$svc" "$host" "$PROXY_PORT" off 2>/dev/null || true
    /usr/sbin/networksetup -setwebproxystate "$svc" on 2>/dev/null || true
    /usr/sbin/networksetup -setsecurewebproxystate "$svc" on 2>/dev/null || true
    /usr/sbin/networksetup -setsocksfirewallproxystate "$svc" off 2>/dev/null || true
    /usr/sbin/networksetup -setautoproxystate "$svc" off 2>/dev/null || true
    /usr/sbin/networksetup -setproxybypassdomains "$svc" \
      "*.iitd.ac.in" "*.iitd.ernet.in" "localhost" "127.0.0.1" "*.local" 2>/dev/null || true
    any=1
  done < <(enable_services)
  [ "$any" -eq 1 ]
}

case "$1" in
  version)
    echo "$HELPER_VERSION"
    exit 0
    ;;
  ping)
    echo ok
    exit 0
    ;;
  cloudflare)
    apply_dns 1.1.1.1 1.0.0.1
    ;;
  google)
    apply_dns 8.8.8.8 8.8.4.4
    ;;
  quad9)
    apply_dns 9.9.9.9 149.112.112.112
    ;;
  opendns)
    apply_dns 208.67.222.222 208.67.220.220
    ;;
  adguard)
    apply_dns 94.140.14.14 94.140.15.15
    ;;
  controld)
    apply_dns 76.76.2.0 76.76.10.0
    ;;
  mullvad)
    apply_dns 194.242.2.2 194.242.2.3
    ;;
  auto)
    apply_dns Empty
    ;;
  flush)
    flush_dns
    echo ok
    exit 0
    ;;
  clear)
    apply_dns Empty
    clear_proxies
    ;;
  proxy-on|proxy62-on)
    enable_iitd_proxy "proxy62.iitd.ac.in" || exit 1
    ;;
  proxy22-on)
    enable_iitd_proxy "proxy22.iitd.ac.in" || exit 1
    ;;
  proxy-off)
    clear_proxies
    ;;
  *)
    echo "usage: $0 {version|ping|…}" >&2
    exit 1
    ;;
esac

flush_dns
echo ok
